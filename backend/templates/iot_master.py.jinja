# ============================================================
# Agri-Gen IoT Firmware
# Auto-generated for Cisco Packet Tracer SBC
# ============================================================
# Multi-Intent Firmware
# Rules Count: {{ rules|length }}
# ============================================================

from gpio import *
from time import *

# -------------------- PIN CONFIGURATION --------------------
# Standard Map
PIN_TEMP = 0
PIN_WATER = 1
PIN_HUMID = 2
PIN_SPRINKLER = 3
PIN_HEATER = 4
PIN_FAN = 5
PIN_SIREN = 6
PIN_LIGHT = 7
PIN_LCD = {{ lcd_pin }}

# Active Devices
{% for dev in devices %}
PIN_{{ dev.name | upper }} = {{ dev.pin }}
{% endfor %}

# Active Sensors
{% for sens in sensors %}
PIN_{{ sens.name | upper }} = {{ sens.pin }}
{% endfor %}

# -------------------- HELPER FUNCTIONS --------------------
def read_sensor(sensor_name, pin):
    """Read value from sensor"""
    if pin is not None:
        return analogRead(pin)
    return 0

def control_device(device_name, pin, state):
    """Control device - ON (1) or OFF (0)"""
    if state:
        customWrite(pin, 1)
        print("[" + device_name.upper() + "] Turned ON")
    else:
        customWrite(pin, 0)
        print("[" + device_name.upper() + "] Turned OFF")

def update_lcd(message):
    """Write to LCD"""
    customWrite(PIN_LCD, message)

# -------------------- MAIN CONTROL LOOP --------------------
def main():
    """Main firmware loop"""
    print("[Agri-Gen] Starting Multi-Device Controller...")
    
    while True:
        # Loop through all rules
        {% for rule in rules %}
        print("--- Processing Rule: {{ rule.device }} ---")
        
        # Rule for {{ rule.device }}
        {% if rule.has_condition %}
        # Check {{ rule.sensor }}
        val_{{ loop.index }} = read_sensor("{{ rule.sensor }}", {{ rule.sensor_pin }})
        print("[Sensor] {{ rule.sensor }}: " + str(val_{{ loop.index }}))
        
        {% if rule.condition == 'below' %}
        if val_{{ loop.index }} < {{ rule.threshold }}:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 1)
            update_lcd("{{ rule.device|upper }}: ON")
        else:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 0)
        {% elif rule.condition == 'above' %}
        if val_{{ loop.index }} > {{ rule.threshold }}:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 1)
            update_lcd("{{ rule.device|upper }}: ON")
        else:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 0)
        {% else %}
        if val_{{ loop.index }} == {{ rule.threshold }}:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 1)
        else:
            control_device("{{ rule.device }}", {{ rule.device_pin }}, 0)
        {% endif %}
        
        {% else %}
        # Direct Action
        {% if rule.action == 'turn_on' %}
        control_device("{{ rule.device }}", {{ rule.device_pin }}, 1)
        update_lcd("{{ rule.device|upper }}: ON")
        {% elif rule.action == 'turn_off' %}
        control_device("{{ rule.device }}", {{ rule.device_pin }}, 0)
        update_lcd("{{ rule.device|upper }}: OFF")
        {% else %}
        # Monitor only
        val_{{ loop.index }} = read_sensor("{{ rule.sensor }}", {{ rule.sensor_pin if rule.sensor_pin else 0 }})
        print("Monitoring {{ rule.device }}: " + str(val_{{ loop.index }}))
        {% endif %}
        {% endif %}
        
        # Small delay between rules to avoid flooding
        delay(500)
        {% endfor %}
        
        print("--- Cycle Complete ---\n")
        delay(2000)

# -------------------- ENTRY POINT --------------------
if __name__ == "__main__":
    main()
